"VertexLitGeneric"
{
    "$basetexture" "creatures/zombie_classic_v2/zombie_classic_v2_c17jacket_rgb"
    "$bumpmap" "creatures/zombie_classic_v2/zombie_classic_v2_c17jacket_n"
    "$phongexponenttexture" "creatures/zombie_classic_v2/zombie_classic_v2_c17jacket_e"

    /////////////////
    "$color2" "[0 0 0]"                                     //do not touch this
    "$blendtintbybasealpha" "1"                             //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "1"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "shared\specularity_00"
    "$envmaptint" "[0.098 0.098 0.098]"              

    "$nodecal" "1"   

    "$DEM_TintScale" 			"[1 1 1]" // Color scaling essentially, if you want default envmap tint, leave this as is
    "$DEM_Multiplier" 			"0.5" // Multiplies the output, should change this based on other $envmap settings that alter the strength/color
    "$DEM_ClampMin" 			"[0 0 0]" // Optional, clamps the output to a minimum value
    "$DEM_ClampMax" 			"[1 1 1]" // Optional, clamps the output to a maximum value
    "$DEM_Color" 				"[1 1 1]" // Optional, changes the envmaptint, otherwise it will use $color (or white) by default

    "Proxies" 
    {
        "DynamicEnvMap"
        {
            resultVar	"$envmaptint"
        }
    }
}